#!/bin/sh
# Puts this machine's local certificate authority into its trust store, so
# https://<site>.test is trusted the way any other site is. Run once.
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

# WSL looks like Linux to uname, but the browser there is a Windows program
# reading a different trust store, so this command is only half the job.
is_wsl() {
    grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null
}

CA=$(mktemp)
trap 'rm -f "$CA"' EXIT INT TERM

# The authority lives in a Docker volume, not the working tree, so its key
# never sits in a directory that might be archived or synced by accident.
if ! docker compose exec -T tls cat /certs/rootCA.pem >"$CA" 2>/dev/null || [ ! -s "$CA" ]; then
    echo "Could not read the authority from the tls service."
    echo "Start the stack first, then run this again:"
    echo "    docker compose up -d"
    exit 1
fi

cat <<EOF
About to trust a certificate authority on this machine:

$(openssl x509 -noout -subject -enddate -fingerprint -sha256 -in "$CA" 2>/dev/null || echo "    (unreadable)")

It was generated by the tls service on this machine and is kept in a Docker
volume rather than the repository. Anything able to read that volume, which
includes anything able to drive Docker here, can issue a certificate this
machine will then believe, for any domain. It is never shared between
developers.

This needs an administrator password.

EOF

printf 'Continue? [y/N] '
read -r reply
case "$reply" in
    [yY] | [yY][eE][sS]) ;;
    *)
        echo "Nothing changed."
        exit 1
        ;;
esac

case "$(uname -s)" in
    Darwin)
        sudo security add-trusted-cert -d -r trustRoot \
            -k /Library/Keychains/System.keychain "$CA"
        ;;
    Linux)
        if command -v update-ca-certificates >/dev/null 2>&1; then
            sudo cp "$CA" /usr/local/share/ca-certificates/reverse-proxy.crt
            sudo update-ca-certificates
        elif command -v update-ca-trust >/dev/null 2>&1; then
            sudo cp "$CA" /etc/pki/ca-trust/source/anchors/reverse-proxy.pem
            sudo update-ca-trust
        else
            echo "No known trust store tool here. The README has the manual route."
            exit 1
        fi
        ;;
    *)
        echo "Not a platform this script handles. The README has the"
        echo "PowerShell command for Windows."
        exit 1
        ;;
esac

if is_wsl; then
    cp "$CA" "$ROOT/rootCA.crt"
    windows_path=$(wslpath -w "$ROOT/rootCA.crt" 2>/dev/null || echo "$ROOT/rootCA.crt")

    cat <<EOF

Half done. This distribution trusts it now, which is what curl and the test
suite use from in here. Your browser is a Windows program reading a separate
store, so Windows needs it too. In PowerShell as Administrator:

    Import-Certificate -FilePath "$windows_path" -CertStoreLocation Cert:\\LocalMachine\\Root

Then delete $ROOT/rootCA.crt. It holds the public certificate and not the
key, but there is no reason to leave it lying about.
EOF
    exit 0
fi

cat <<'EOF'

Done. Chrome, Safari, Edge and curl follow the system trust store.

Firefox keeps its own, but recent versions read the system store as well, so
it usually needs nothing. If it does not pick the authority up, write it out
with

    docker compose cp tls:/certs/rootCA.pem ./rootCA.pem

then load it under Settings > Privacy & Security > Certificates > View
Certificates > Authorities > Import, with "Trust this CA to identify
websites" ticked, and delete the copy afterwards.
EOF
