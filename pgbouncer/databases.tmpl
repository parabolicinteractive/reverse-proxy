{{/*
  Generated into pgbouncer's routing table by docker-gen, which rewrites it
  whenever a container starts or stops and then signals pgbouncer to reload.

  A project opts in with one label on its database service:

      labels:
        chronicle.postgres.expose: "true"

  Everything else is read off the container: the compose project supplies the
  name a client selects, and POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
  supply the upstream credentials. The container name is the host, which is
  unique per stack, so no network alias has to be invented.

  Set chronicle.postgres.name to override the selectable name.
*/}}
; Generated by docker-gen. Edits are overwritten on the next container event.
[databases]
{{- range $c := whereLabelValueMatches $ "chronicle.postgres.expose" "(?i)^(true|1|yes)$" }}
{{- $project := index $c.Labels "com.docker.compose.project" }}
{{- $name := or (index $c.Labels "chronicle.postgres.name") $project }}
{{- $db := or (index $c.Env "POSTGRES_DB") $name }}
{{- $user := or (index $c.Env "POSTGRES_USER") "postgres" }}
{{- $pass := index $c.Env "POSTGRES_PASSWORD" }}
{{ $name }} = host={{ $c.Name }} port=5432 dbname={{ $db }} user={{ $user }} password={{ $pass }}
{{- end }}
